# SPDX-License-Identifier: MIT
# Link with LLD directly: host CRTs and standard libraries cannot be injected.
set(_qnx_link "<CMAKE_LINKER> -m armelf --hash-style=sysv --no-undefined --no-rosegment -z max-page-size=4096 -z norelro --build-id=none --disable-new-dtags")
foreach(lang C CXX ASM)
  set(CMAKE_${lang}_LINKER_WRAPPER_FLAG "")
  set(CMAKE_${lang}_LINKER_WRAPPER_FLAG_SEP "")
  set(CMAKE_SHARED_LIBRARY_${lang}_FLAGS "-fPIC")
  set(CMAKE_SHARED_LIBRARY_RUNTIME_${lang}_FLAG "-rpath ")
  set(CMAKE_SHARED_LIBRARY_RUNTIME_${lang}_FLAG_SEP ":")
  set(CMAKE_SHARED_LIBRARY_SONAME_${lang}_FLAG "-soname ")
  set(CMAKE_SHARED_LIBRARY_LINK_${lang}_FLAGS "")
  set(CMAKE_${lang}_LINK_EXECUTABLE "${_qnx_link} --image-base=0x100000 --dynamic-linker /usr/lib/ldqnx.so.2 <LINK_FLAGS> <OBJECTS> ${QNX_SDK}/usr/lib/crt1.o ${QNX_SDK}/usr/lib/libqnx-support.a -o <TARGET> --as-needed <LINK_LIBRARIES>")
  set(CMAKE_${lang}_CREATE_SHARED_LIBRARY "${_qnx_link} -shared --soname=<TARGET_SONAME> <LINK_FLAGS> <OBJECTS> ${QNX_SDK}/usr/lib/libqnx-support.a -o <TARGET> --as-needed <LINK_LIBRARIES>")
  set(CMAKE_${lang}_CREATE_SHARED_MODULE "${CMAKE_${lang}_CREATE_SHARED_LIBRARY}")
  set(CMAKE_${lang}_STANDARD_LIBRARIES "${QNX_SDK}/usr/lib/libstdc++.so.6 ${QNX_SDK}/usr/lib/libm.so.2 ${QNX_SDK}/usr/lib/libc.so.3")
  foreach(type SHARED_LIBRARY SHARED_MODULE EXE)
    set(CMAKE_${type}_LINK_STATIC_${lang}_FLAGS "")
    set(CMAKE_${type}_LINK_DYNAMIC_${lang}_FLAGS "")
  endforeach()
endforeach()
