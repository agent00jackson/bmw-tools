# SPDX-License-Identifier: MIT
set(CMAKE_SYSTEM_NAME QNX)
set(CMAKE_SYSTEM_VERSION 6.5.0)
set(CMAKE_SYSTEM_PROCESSOR armv7le)
get_filename_component(QNX_SDK "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(QNX_CLANG "@QNX_CLANG@")
set(QNX_LLD "@QNX_LLD@")
set(CMAKE_C_COMPILER "${QNX_CLANG}")
set(CMAKE_CXX_COMPILER "@QNX_CLANG@++")
set(CMAKE_ASM_COMPILER "${QNX_CLANG}")
set(CMAKE_C_COMPILER_TARGET armv7-none-eabi)
set(CMAKE_CXX_COMPILER_TARGET armv7-none-eabi)
set(CMAKE_ASM_COMPILER_TARGET armv7-none-eabi)
set(CMAKE_LINKER "${QNX_LLD}")
set(CMAKE_AR "@QNX_AR@")
set(CMAKE_RANLIB "@QNX_RANLIB@")
set(CMAKE_STRIP "@QNX_STRIP@")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${QNX_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/QnxRules.cmake")
set(_flags "-march=armv7-a -marm -mfpu=vfpv3 -mfloat-abi=softfp -mno-unaligned-access -fno-short-enums -fno-short-wchar -nostdlibinc -fno-stack-protector -D__QNXNTO__=1 -D__QNX__=1 -D__ARM__=1 -D__LITTLEENDIAN__=1 -D_QNX_SOURCE")
set(CMAKE_C_FLAGS_INIT "${_flags} -isystem ${QNX_SDK}/usr/include")
set(CMAKE_CXX_FLAGS_INIT "${_flags} -nostdinc++ -U__GXX_EXPERIMENTAL_CXX0X__ -Wno-c++11-narrowing -isystem ${QNX_SDK}/usr/include/c++/4.4.2 -isystem ${QNX_SDK}/usr/include/c++/4.4.2/arm-unknown-nto-qnx6.5.0eabi -isystem ${QNX_SDK}/usr/include")
set(CMAKE_ASM_FLAGS_INIT "--target=armv7-none-eabi ${_flags}")
list(PREPEND CMAKE_PREFIX_PATH "${QNX_SDK}")
