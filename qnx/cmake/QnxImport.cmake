# Generate link interfaces from ELF symbol metadata. These are never installed
# as runtime libraries by an application consuming this module.
function(qnx_import_manifest manifest output_dir namespace result)
  file(READ "${manifest}" metadata)
  string(JSON count LENGTH "${metadata}" libraries)
  math(EXPR last "${count} - 1")
  file(MAKE_DIRECTORY "${output_dir}")
  set(targets)
  foreach(index RANGE 0 ${last})
    string(JSON soname GET "${metadata}" libraries ${index} soname)
    string(JSON symbols LENGTH "${metadata}" libraries ${index} symbols)
    math(EXPR symbol_last "${symbols} - 1")
    set(assembly ".syntax unified\n.arm\n")
    foreach(symbol RANGE 0 ${symbol_last})
      string(JSON name GET "${metadata}" libraries ${index} symbols ${symbol} name)
      string(JSON kind GET "${metadata}" libraries ${index} symbols ${symbol} kind)
      string(JSON size GET "${metadata}" libraries ${index} symbols ${symbol} size)
      if(NOT name MATCHES "^[A-Za-z_.$][A-Za-z0-9_.$]*$")
        message(FATAL_ERROR "Unsupported import symbol: ${name}")
      endif()
      if(kind STREQUAL "object")
        string(APPEND assembly ".bss\n.balign 8\n.global ${name}\n.type ${name},%object\n${name}:\n.space ${size}\n.size ${name},${size}\n")
      elseif(kind STREQUAL "function")
        string(APPEND assembly ".text\n.balign 4\n.global ${name}\n.type ${name},%function\n${name}:\nudf #0\n.size ${name},.-${name}\n")
      else()
        message(FATAL_ERROR "Unsupported import symbol kind: ${kind}")
      endif()
    endforeach()
    string(APPEND assembly ".section .note.GNU-stack,\"\",%progbits\n")
    set(source "${output_dir}/${soname}.S")
    set(object "${output_dir}/${soname}.o")
    set(library "${output_dir}/${soname}")
    file(CONFIGURE OUTPUT "${source}" CONTENT "${assembly}" @ONLY)
    string(REGEX REPLACE "^lib" "" target "${soname}")
    string(REGEX REPLACE "\\.so.*$" "" target "${target}")
    string(MAKE_C_IDENTIFIER "${namespace}_${target}" build_target)
    add_custom_command(OUTPUT "${library}"
      COMMAND "${QNX_CLANG}" --target=armv7-none-eabi -c "${source}" -o "${object}"
      COMMAND "${QNX_LLD}" -m armelf --hash-style=sysv -shared -soname "${soname}" -o "${library}" "${object}"
      DEPENDS "${source}" "${manifest}" VERBATIM)
    add_custom_target("${build_target}" DEPENDS "${library}")
    add_library("${namespace}::${target}" SHARED IMPORTED GLOBAL)
    set_target_properties("${namespace}::${target}" PROPERTIES IMPORTED_LOCATION "${library}" IMPORTED_SONAME "${soname}")
    add_dependencies("${namespace}::${target}" "${build_target}")
    list(APPEND targets "${namespace}::${target}")
  endforeach()
  set(${result} "${targets}" PARENT_SCOPE)
endfunction()
